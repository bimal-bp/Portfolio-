<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Bimal Patra — Data Science & Analytics professional working in MIS reporting, business intelligence, ERP automation, and plant operations.">
  <meta name="theme-color" content="#172554">
  <title>Bimal Patra | Data & Operations Analytics</title>
  <style>
    /* Change these variables to customize the portfolio colors. */
    :root{--bg:#f5f8fc;--ink:#172554;--muted:#526279;--green:#0f766e;--lime:#99f6e4;--line:#dce2ec;--white:#fff;--radius:18px}
    *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.65}a{color:inherit}a:focus-visible,button:focus-visible{outline:3px solid #0f766e;outline-offset:5px}a:hover{text-decoration-thickness:2px}::selection{background:var(--lime)}.wrap{width:min(1120px,calc(100% - 48px));margin:auto}.skip{position:absolute;left:12px;top:-80px;background:white;padding:12px;z-index:10}.skip:focus{top:12px}header{position:sticky;top:0;background:rgba(245,248,252,.97);border-bottom:1px solid var(--line);z-index:5}.nav{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:82px}.brand{text-decoration:none;font-weight:800;font-size:20px;letter-spacing:-1px}.brand span{display:inline-grid;place-items:center;background:var(--ink);color:var(--lime);width:38px;height:38px;border-radius:50%;margin-right:10px;letter-spacing:0;font-size:13px}nav{display:flex;gap:25px;align-items:center}nav a{text-decoration:none;font-size:14px;font-weight:600}.nav-contact{border:1px solid var(--ink);padding:9px 17px;border-radius:50px}.hero{display:grid;grid-template-columns:1.25fr .85fr;gap:60px;align-items:center;padding:88px 0 70px}.eyebrow{text-transform:uppercase;font-size:11px;letter-spacing:2px;font-weight:800;color:var(--green);margin:0 0 20px}.hero h1{font-size:clamp(45px,6vw,76px);line-height:1.08;letter-spacing:-3px;margin:0 0 26px}.hero h1 em{font-family:Georgia,serif;font-weight:400}.intro{font-size:18px;max-width:610px;color:var(--muted)}.intro strong{color:var(--ink)}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:center;gap:16px;padding:13px 22px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:700;background:var(--ink);color:white;border:1px solid var(--ink)}.button.secondary{background:transparent;color:var(--ink)}.button:hover{background:var(--green);color:white}.profile{background:var(--ink);color:var(--white);border-radius:24px;padding:32px;position:relative;overflow:hidden}.profile:before{content:"";position:absolute;width:210px;height:210px;border:1px solid #53627a;border-radius:50%;right:-80px;top:-90px}.profile-top{display:flex;justify-content:space-between;gap:16px;align-items:center}.profile .eyebrow{color:var(--lime);margin:0;font-size:10px}.avatar{width:76px;height:76px;border-radius:50%;display:grid;place-items:center;background:var(--lime);color:var(--ink);font-family:Georgia,serif;font-size:29px;margin:42px 0 22px}.profile h2{font-size:30px;letter-spacing:-1px;margin:0}.profile p{color:#d1dbea;margin:5px 0 25px}.profile dl{margin:25px 0 0;border-top:1px solid #43536c}.profile dl div{padding:14px 0;border-bottom:1px solid #43536c}.profile dt{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#d1dbea}.profile dd{margin:2px 0 0;font-size:14px}.strip{border-block:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;padding:20px 0;font-size:13px;font-weight:700;flex-wrap:wrap}.strip span:before{content:'✦';color:var(--green);margin-right:12px}section{padding:75px 0;border-bottom:1px solid var(--line)}.section-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end;margin-bottom:32px}.section-head h2{font-size:38px;line-height:1.2;letter-spacing:-1.5px;margin:0}.section-head .eyebrow{margin-bottom:12px}.section-head p{color:var(--muted);margin:0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:28px}.number{font-family:Georgia,serif;color:var(--green);font-size:28px;display:block;margin-bottom:28px}.card h3{font-size:20px;line-height:1.3;margin:0 0 14px;letter-spacing:-.4px}.card p{color:var(--muted);font-size:14px;margin:0 0 22px}.tags{display:flex;gap:7px;flex-wrap:wrap}.tag{font-size:11px;background:#e6f5f2;color:var(--green);padding:5px 10px;border-radius:4px}.experience{display:grid;grid-template-columns:250px 1fr;gap:40px;background:#edf2fa;padding:32px;border-radius:var(--radius)}.experience h3{font-size:23px;line-height:1.4;margin:0 0 8px}.experience .date{font-size:13px;color:var(--green);font-weight:700}.experience ul{padding-left:20px;margin:15px 0 0;color:var(--muted)}.experience li{margin:9px 0}.skills{display:grid;grid-template-columns:1fr 1fr;gap:18px}.skill-row{padding:25px;border:1px solid var(--line);border-radius:12px}.skill-row h3{font-size:16px;margin:0 0 14px}.skill-row p{color:var(--muted);margin:0;font-size:14px}.education{display:grid;grid-template-columns:1fr 1fr;gap:18px}.education .card h3{font-size:18px}.education .card p{margin-bottom:0}.certificate{margin-top:20px;font-size:14px;color:var(--muted)}.contact{margin:70px 0;background:var(--ink);color:white;padding:50px;border-radius:24px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.contact h2{font-size:38px;line-height:1.2;letter-spacing:-1px;margin:0 0 18px}.contact .eyebrow{color:var(--lime)}.contact p{color:#d1dbea;margin:0}.contact-links{display:grid;gap:14px}.contact-links a{display:block;padding:14px 0;border-bottom:1px solid #43536c;text-decoration:none;overflow-wrap:anywhere}.contact-links a span{float:right;color:var(--lime)}footer{padding:0 0 30px;display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:12px}
    @media(max-width:850px){.hero{gap:30px;grid-template-columns:1fr 1fr}.cards{grid-template-columns:1fr}.number{margin-bottom:15px}.experience{grid-template-columns:1fr;gap:12px}nav{gap:15px}.contact{padding:32px}}
    @media(max-width:620px){.wrap{width:calc(100% - 32px)}.nav{min-height:76px;flex-wrap:wrap;gap:12px;padding:16px 0}nav{width:100%;justify-content:space-between;gap:10px}nav a{font-size:12px}.nav-contact{padding:5px 10px}.hero{grid-template-columns:1fr;padding:48px 0;gap:35px}.hero h1{letter-spacing:-2px}.profile{padding:26px}.avatar{margin-top:26px}.section-head,.skills,.education,.contact{grid-template-columns:1fr;gap:20px}.section-head h2,.contact h2{font-size:32px}section{padding:50px 0}.contact{margin:45px 0;padding:28px}.strip{font-size:12px;gap:12px}.card{padding:24px}footer{flex-direction:column;gap:5px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    @media print{header,.actions,.skip{display:none}body{background:white}.hero,section{padding:20px 0}.contact{margin:20px 0}.card,.experience,.profile{break-inside:avoid}}

    /* Project galleries and appreciation cards. */
    .project-list{display:grid;gap:24px}.project h3{font-size:26px}.project>p{max-width:880px}.project .eyebrow{margin-bottom:12px}.project h4{margin:27px 0 3px;font-size:16px}.project .gallery-note{font-size:12px;margin-bottom:14px}.project .password{margin:14px 0 0;font-size:13px}.password code{font-size:15px;color:var(--ink);background:#e6f5f2;padding:4px 8px;border-radius:4px}.password button{margin:8px;border:1px solid var(--line);border-radius:4px;padding:6px 10px;background:white;color:var(--ink);cursor:pointer}.report-gallery{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.gallery-item{margin:0;min-width:0}.thumb{display:flex;align-items:center;justify-content:center;width:100%;height:125px;background:#f1f4f9;border:1px solid var(--line);border-radius:8px;overflow:hidden;position:relative;color:var(--muted);text-align:center;text-decoration:none;padding:8px;font-size:12px}.thumb img{width:100%;height:100%;object-fit:contain;transition:transform .2s}.thumb:hover img{transform:scale(1.04)}.gallery-item figcaption{font-size:12px;line-height:1.4;margin-top:9px}.placeholder{border-style:dashed;flex-direction:column;gap:8px;padding:16px}.placeholder span{font-size:11px;color:var(--muted)}.placeholder strong{font-size:20px;font-weight:400}.erp-list{padding-left:20px;color:var(--muted);font-size:15px;max-width:900px}.erp-list li{margin:15px 0}.erp-list strong{color:var(--ink)}.feedback-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.feedback-card{padding:24px}.feedback-card h3{font-size:18px;margin:0 0 6px}.feedback-card .person{font-size:13px;margin:0 0 16px}.feedback-card .thumb{height:190px}.feedback-card .gallery-item figcaption{color:var(--muted)}dialog{width:min(1100px,95vw);max-height:92vh;border:0;border-radius:14px;padding:18px;background:var(--bg);color:var(--ink)}dialog::backdrop{background:rgba(0,0,0,.8)}.viewer-top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:12px}.viewer-top h2{font-size:18px;margin:0}.viewer-top button{background:var(--ink);color:white;border:0;border-radius:5px;padding:10px 16px;cursor:pointer}#viewer-image{display:block;width:100%;max-height:70vh;object-fit:contain}#viewer-source{display:inline-block;font-size:13px;margin-top:12px}
    @media(max-width:850px){.report-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.feedback-grid{grid-template-columns:1fr}.feedback-card .thumb{height:200px}}
    @media(max-width:620px){.report-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.project h3{font-size:23px}.project .actions{gap:10px}.project .button{width:100%;font-size:13px}.hero{padding-top:38px}html{scroll-padding-top:135px}nav{flex-wrap:wrap}}

    /* Indigo and teal theme. */
    .hero{padding:55px 0;gap:40px}.hero h1{font-size:clamp(42px,6vw,68px);margin-bottom:12px}.role-title{font-size:21px;font-weight:700;color:var(--green);margin:0 0 20px}.button:not(.secondary){background:#0f766e;border-color:#0f766e;color:var(--ink)}.button:hover{background:var(--ink);border-color:var(--ink);color:white}.button{transition:background .15s,color .15s}.nav-contact{background:var(--ink);color:white}nav a:hover{color:var(--green)}nav .nav-contact:hover{color:var(--ink);background:#99f6e4}.project{border-top:4px solid #0f766e}.report-gallery{margin-top:28px;align-items:start}.thumb{height:150px;background:white;border-color:#ccd6e6}.thumb:hover{border-color:#0f766e}.gallery-item figcaption{font-weight:700;color:var(--ink)}.excel-link{flex-direction:column;gap:14px;background:#e6f5f2;color:var(--ink)}.excel-link:hover{background:#ccfbf1}.file-icon{background:var(--ink);color:#99f6e4;border-radius:6px;padding:10px 14px;font-size:16px;font-weight:800}.file-caption{font-weight:700!important;color:var(--ink)!important;font-size:12px!important;margin:9px 0 0!important;line-height:1.4}.download-tile .password{margin-top:8px;font-size:12px}.password button{margin:7px 6px 0 0}.skills-list{display:grid;grid-template-columns:1fr 1fr;gap:0 38px;list-style:none;padding:0;margin:0}.skills-list li{position:relative;padding:20px 10px 20px 25px;border-bottom:1px solid var(--line)}.skills-list li:before{content:'•';position:absolute;left:0;color:#0f766e;font-size:24px;top:13px}.skills-list strong,.skills-list span{display:block}.skills-list strong{font-size:16px}.skills-list span{font-size:14px;color:var(--muted);margin-top:4px}.feedback-card{border-top:3px solid var(--ink)}.feedback-card:nth-child(2){border-top-color:#0f766e}.thumb:focus-visible{outline:3px solid #0f766e;outline-offset:4px}
    @media(max-width:620px){.hero{padding:35px 0;grid-template-columns:1fr}.skills-list{grid-template-columns:1fr}.thumb{height:125px}.role-title{font-size:18px}}
    @media(max-width:370px){.report-gallery{grid-template-columns:1fr}}
    @media(prefers-reduced-motion:reduce){.thumb img,.button{transition:none}}

    /* Rounded profile, clear actions, and keyboard-friendly interactions. */
    body{background:radial-gradient(ellipse at 90% 8%,#e0f2f1 0,transparent 35%),var(--bg)}
    .hero{grid-template-columns:1.15fr 1fr;gap:48px}
    .button{border-radius:999px;transition:transform .2s,background .2s,box-shadow .2s}
    .button:not(.secondary){color:white}
    .button:hover{transform:translateY(-3px);box-shadow:0 8px 20px #17255420}
    .profile{border-radius:40px;padding:32px;background:linear-gradient(145deg,#172554,#174453);border:1px solid #ffffff40;box-shadow:0 24px 65px #17255424;transition:transform .25s,box-shadow .25s}
    .profile:hover,.profile:focus-within{transform:translateY(-5px);box-shadow:0 30px 70px #17255435}
    .profile:before{pointer-events:none;border-color:#99f6e440;width:250px;height:250px}
    .profile-top{position:relative}.profile-spark{color:#99f6e4;font-size:24px}
    .portrait-link{display:block;position:relative;width:148px;height:148px;margin:24px auto 18px;border:4px solid #99f6e4;border-radius:50%;box-shadow:0 0 0 8px #99f6e413;overflow:hidden;background:#254e5d}
    .portrait-link img{width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block;transition:transform .25s}
    .portrait-link:hover img{transform:scale(1.06)}
    .portrait-hint{position:absolute;bottom:0;left:0;right:0;background:#172554dd;color:white;font-size:10px;text-align:center;padding:5px 0 9px}
    .profile h2,.profile .profile-subtitle{text-align:center}.profile h2{font-size:32px}.profile .profile-subtitle{margin:4px 0 22px;color:#d5e5eb}
    .profile dl{border:0;display:grid;gap:10px;margin:0}
    .profile dl div{padding:12px 16px;border:1px solid #ffffff20;background:#ffffff09;border-radius:18px}
    .profile dt{color:#a8dad5}.profile dd{color:#fff;line-height:1.5}
    .profile-phone{display:flex;justify-content:space-between;margin:20px 2px 14px;text-decoration:none;font-size:16px;font-weight:700;color:#ccfbf1}
    .profile-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .profile-actions .button{padding:11px 12px;font-size:13px;background:#99f6e4;border-color:#99f6e4;color:#123741}
    .profile-actions .secondary{background:transparent;color:#fff;border-color:#ffffff60}
    .profile-actions .button:hover{background:white;color:#172554;border-color:white}
    .card,.skill-row{transition:transform .2s,box-shadow .2s}.card:hover{box-shadow:0 12px 30px #1725540d}
    .feedback-card{border-radius:24px}.feedback-card:hover{transform:translateY(-4px)}
    .tag,.thumb,.file-icon{border-radius:12px}.file-icon{color:#99f6e4}
    .contact{border-radius:32px;background:linear-gradient(120deg,#172554,#174453)}
    .contact-links a:hover{color:#99f6e4}.thumb:hover{border-color:#0f766e}
    @media(max-width:850px){.hero{gap:28px;grid-template-columns:1fr 1fr}.profile{padding:24px}.profile-actions{grid-template-columns:1fr}}
    @media(max-width:620px){.hero{grid-template-columns:1fr}.profile{border-radius:32px;padding:26px}.profile-actions{grid-template-columns:1fr 1fr}.portrait-link{width:148px;height:148px}.contact{padding:26px}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important}.profile:hover,.profile:focus-within,.button:hover,.feedback-card:hover,.portrait-link:hover img,.thumb:hover img{transform:none}}
  </style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><div class="wrap nav"></a><nav aria-label="Main navigation"><a href="#projects">Projects</a><a href="#skills">Skills</a><a href="#feedback">Appreciation</a><a class="nav-contact" href="#contact">Let's connect ↗</a></nav></div></header>
<main id="main" class="wrap">
  <div class="hero">
    <div><h1>Bimal Patra</h1><p class="role-title">MIS Reporting &amp; ERP Automation</p><p class="intro">An analytics professional connecting data, technology, and plant operations through MIS reporting, dashboards, and ERP automation.</p><div class="actions"><a class="button" href="#projects">View my projects <span aria-hidden="true">↗</span></a><a class="button secondary" href="https://www.linkedin.com/in/bimalts789/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
    <aside class="profile" aria-label="Professional profile">
      <div class="profile-top"><p class="eyebrow">The person behind the data</p><span class="profile-spark" aria-hidden="true">✦</span></div>
      <a class="portrait-link" id="profile-photo" href="https://raw.githubusercontent.com/bimal-bp/Portfolio-/main/profile-picture.jpeg" target="_blank" rel="noopener noreferrer" aria-label="Enlarge Bimal Patra's profile photo">
        <img src="https://raw.githubusercontent.com/bimal-bp/Portfolio-/main/profile-picture.jpeg" alt="Bimal Patra" width="70" height="70" fetchpriority="high">
      </a>
      <dl><div><dd>Officer – Artificial Intelligence Process</dd></div><div><dd>SGX Minerals Pvt Ltd</dd></div></dl>
      <a class="profile-phone" href="tel:+919348245158">+91 9348245158 <span aria-hidden="true">↗</span></a>
      <div class="profile-actions"><a class="button" href="tel:+919348245158">Call me ↗</a><a class="button secondary" href="https://wa.me/919348245158" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div>
    </aside>
  </div>
  <section id="projects">
    <div class="section-head"><div><p class="eyebrow">01 / Projects</p></div></div>
    <div class="project-list">
      <article class="card project"><p class="eyebrow">Project 01</p><h3>MIS Reporting &amp; Dashboards</h3><p>Excel-based operational reports and dashboards covering quarry and plant production, dispatch, machinery availability, fuel consumption, and maintenance. KPI summaries, daily and month-to-date tracking, and target-versus-achievement analysis support management review.</p>
        <div class="tags"><span class="tag">Advanced Excel</span><span class="tag">MIS Reporting</span><span class="tag">KPI Dashboards</span></div>
        <div class="report-gallery" id="report-gallery">
          <div class="download-tile" id="excel-download">
            <a class="thumb excel-link" href="https://github.com/bimal-bp/Portfolio-/raw/refs/heads/main/MIS%20-%20Report%20-%20Bimal%20Patra.xlsx" target="_blank" rel="noopener noreferrer"><span class="file-icon" aria-hidden="true">XLSX</span><strong>Download Excel ↓</strong></a>
            <p class="file-caption">MIS Excel workbook</p>
            <p class="password">Password: <code>4142</code><br><button id="copy-password" type="button">Copy password</button><span id="copy-status" role="status"></span></p>
          </div>
        </div>
        <noscript><p><a href="https://github.com/bimal-bp/Portfolio-/blob/main/Mis-report-.jpeg">MIS report</a> · <a href="https://github.com/bimal-bp/Portfolio-/blob/main/mis-dash.jpeg">MIS dashboard</a> · <a href="https://github.com/bimal-bp/Portfolio-/blob/main/diesel-mis.jpeg">Diesel report</a></p></noscript>
      </article>
      <article class="card project"><p class="eyebrow">Project 02</p><h3>ERP &amp; Process Automation</h3><p>Operational workflows that connect vehicle tracking, data capture, attendance, and vendor communication.</p>
        <ul class="erp-list"><li><strong>Vehicle movement alerts:</strong> WhatsApp integration to share vehicle movement notifications and operational updates.</li><li><strong>Photo-based data entry:</strong> Extract data from uploaded photos to support direct entry into ERP records and reduce manual typing.</li><li><strong>Location-based attendance:</strong> Capture attendance with location, a photo, and a timestamp for verification.</li><li><strong>Billing &amp; vendor invoices:</strong> Prepare billing records and send invoices to vendors through the workflow.</li></ul>
      </article>
    </div>
  </section>
  <section id="feedback">
    <div class="section-head"><div><p class="eyebrow">02 / Recognition</p><h2>Feedback &amp; Appreciation</h2></div><p>Appreciation received from my Executive Director, Team Lead, and IT Head. Select a screenshot to read the full feedback.</p></div>
    <div class="feedback-grid" id="feedback-grid"></div>
    <noscript><p><a href="https://github.com/bimal-bp/Portfolio-/blob/main/ED-Rajesh%20sir-Feedback.jpeg">Executive Director feedback</a> · <a href="https://github.com/bimal-bp/Portfolio-/blob/main/TL.jpeg">Team Lead feedback</a> · <a href="https://github.com/bimal-bp/Portfolio-/blob/main/It-head%20Feedaback.jpeg">IT Head feedback</a></p></noscript>
  </section>
  <section id="experience"><div class="section-head"><div><p class="eyebrow">03 / Experience</p><h2>Analytics meets<br>on-ground operations.</h2></div></div><article class="experience"><div><p class="date">March 2025 – Present</p><strong>SGX Minerals Pvt Ltd</strong></div><div><h3>Officer – Artificial Intelligence Process</h3><ul><li>Develop and enhance ERP systems to streamline operational processes and improve data accuracy.</li><li>Design and maintain MIS reports, dashboards, and automated reporting using Advanced Excel, Power BI, and AI-powered tools.</li><li>Apply working knowledge of quarry-to-plant processes to monitor performance and identify operational bottlenecks.</li><li>Support IT infrastructure, network connectivity, office systems, and weighbridge integration.</li></ul></div></article></section>
  <section id="skills"><div class="section-head"><div><p class="eyebrow">04 / Skills</p><h2>Practical skills</h2></div><p>Reporting, business processes, automation, and team coordination.</p></div>
    <ul class="skills-list">
      <li><strong>Microsoft Excel</strong><span>Data entry, formatting, tables, and everyday formulas.</span></li>
      <li><strong>Advanced Excel</strong><span>Pivot Tables, advanced formulas, dashboards, and reporting.</span></li>
      <li><strong>Basic Accounting Knowledge</strong><span>Understanding of billing, invoices, and expense records.</span></li>
      <li><strong>MIS Reporting</strong><span>Daily and monthly reports, KPI tracking, and management summaries.</span></li>
      <li><strong>ERP &amp; Process Automation</strong><span>Digital workflows, data capture, alerts, and operational records.</span></li>
      <li><strong>SAP Module Familiarity</strong><span>Basic familiarity with SAP modules and business workflows.</span></li>
      <li><strong>Team Leadership &amp; Coordination</strong><span>Task coordination, follow-ups, and cross-team communication.</span></li>
      <li><strong>Power BI &amp; Data Analysis</strong><span>Visual dashboards, performance analysis, and business insights.</span></li>
    </ul>
  </section>
  <section id="education"><div class="section-head"><div><p class="eyebrow">05 / Education</p><h2>A foundation in science.<br>A focus on data.</h2></div></div><div class="education"><article class="card"><h3>Full Stack Data Science and AI</h3><p>Certification · 78%</p></article><article class="card"><h3>Bachelor of Science in Physics</h3><p>B.Sc. · 62%</p></article></div><p class="certificate"><strong>Additional certification:</strong> Data Analytics and Visualization Virtual Experience · June–July 2023<br>Project understanding, data cleaning and modeling, data visualization and storytelling. <a href="https://drive.google.com/file/d/1t9ea5xcOKZWprhdnZdUckpsAK5LG6kZZ/view?usp=sharing" target="_blank" rel="noopener noreferrer">View certificate ↗</a></p></section>
  <section class="contact" id="contact"><div><p class="eyebrow">06 / Get in touch</p><h2>Let's turn data<br>into meaningful work.</h2><p>Connect with me about data analytics, business intelligence, and operational improvement.</p></div><div class="contact-links"><a href="tel:+919348245158">+91 9348245158 <span aria-hidden="true">↗</span></a><a href="https://wa.me/919348245158" target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a><a href="mailto:bimalpatrabp9@gmail.com">bimalpatrabp9@gmail.com <span aria-hidden="true">↗</span></a><a href="https://www.linkedin.com/in/bimalts789/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a><a href="https://github.com/bimal-bp" target="_blank" rel="noopener noreferrer">Explore GitHub <span aria-hidden="true">↗</span></a></div></section>
</main><footer class="wrap"><span>© <span id="year">2026</span> Bimal Patra</span><span>Data. Clarity. Better decisions.</span></footer>
<dialog id="image-viewer" aria-labelledby="viewer-title"><div class="viewer-top"><h2 id="viewer-title">Image preview</h2><button id="close-viewer" type="button">Close ×</button></div><img id="viewer-image" alt=""><a id="viewer-source" target="_blank" rel="noopener noreferrer">Open original image ↗</a></dialog>
<script>
/* EDIT YOUR IMAGES HERE.
   Paste a GitHub image link in each empty url field. Both blob links and
   raw.githubusercontent.com links work. Keep the filename case exactly right.
   Add the person's name beside their role when you have the details.
   Existing report links are included below; no upload is needed for them.
*/
const reportImages = [
  {title: 'MIS report', url: 'https://github.com/bimal-bp/Portfolio-/blob/main/Mis-report-.jpeg'},
  {title: 'MIS dashboard', url: 'https://github.com/bimal-bp/Portfolio-/blob/main/mis-dash.jpeg'},
  {title: 'Diesel report', url: 'https://github.com/bimal-bp/Portfolio-/blob/main/diesel-mis.jpeg'}
];
const appreciation = [
  {role: 'Executive Director', name: 'Rajesh Sir', url: 'https://github.com/bimal-bp/Portfolio-/blob/main/ED-Rajesh%20sir-Feedback.jpeg'},
  {role: 'Team Lead', name: '', url: 'https://github.com/bimal-bp/Portfolio-/blob/main/TL.jpeg'},
  {role: 'IT Head', name: '', url: 'https://github.com/bimal-bp/Portfolio-/blob/main/It-head%20Feedaback.jpeg'}
];
function rawImageUrl(url) {
  try {
    const parsed = new URL(url);
    if (parsed.hostname === 'github.com' && parsed.pathname.includes('/blob/')) {
      return 'https://raw.githubusercontent.com' + parsed.pathname.replace('/blob/', '/');
    }
  } catch (_) { return url; }
  return url;
}
const viewer = document.getElementById('image-viewer');
const profilePhoto = document.getElementById('profile-photo');
profilePhoto.addEventListener('click', event => {
  if (typeof viewer.showModal !== 'function') return;
  event.preventDefault();
  document.getElementById('viewer-title').textContent = 'Bimal Patra — Profile photo';
  const large = document.getElementById('viewer-image');
  large.src = profilePhoto.href; large.alt = 'Bimal Patra';
  document.getElementById('viewer-source').href = profilePhoto.href;
  viewer.showModal();
});
function imageCard(title, url, isFeedback = false) {
  const figure = document.createElement('figure');
  figure.className = 'gallery-item';
  if (url) {
    const link = document.createElement('a');
    link.className = 'thumb'; link.href = rawImageUrl(url);
    link.target = '_blank'; link.rel = 'noopener noreferrer';
    link.setAttribute('aria-label', 'Enlarge ' + title);
    const img = document.createElement('img');
    img.src = rawImageUrl(url); img.alt = title; img.loading = 'lazy';
    img.addEventListener('error', () => {
      link.textContent = 'Open image on GitHub ↗';
      link.href = url;
      link.dataset.failed = 'true';
    });
    link.append(img);
    link.addEventListener('click', event => {
      if (link.dataset.failed || typeof viewer.showModal !== 'function') return;
      event.preventDefault();
      document.getElementById('viewer-title').textContent = title;
      const large = document.getElementById('viewer-image');
      large.src = rawImageUrl(url); large.alt = title;
      document.getElementById('viewer-source').href = url;
      viewer.showModal();
    });
    figure.append(link);
  } else {
    const placeholder = document.createElement('div');
    placeholder.className = 'thumb placeholder';
    const icon = document.createElement('strong'); icon.textContent = '+';
    icon.setAttribute('aria-hidden', 'true');
    const text = document.createElement('span');
    text.textContent = 'Appreciation screenshot coming soon';
    placeholder.append(icon, text); figure.append(placeholder);
  }
  const caption = document.createElement('figcaption');
  caption.textContent = title; figure.append(caption); return figure;
}
reportImages.forEach(item => document.getElementById('report-gallery').insertBefore(imageCard(item.title, item.url), document.getElementById('excel-download')));
appreciation.forEach(item => {
  const card = document.createElement('article'); card.className = 'card feedback-card';
  const heading = document.createElement('h3'); heading.textContent = item.role; card.append(heading);
  if (item.name) { const name = document.createElement('p'); name.className = 'person'; name.textContent = item.name; card.append(name); }
  card.append(imageCard('Appreciation from ' + (item.name || item.role), item.url, true));
  document.getElementById('feedback-grid').append(card);
});
document.getElementById('close-viewer').addEventListener('click', () => viewer.close());
viewer.addEventListener('click', event => { if (event.target === viewer) { const r = viewer.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) viewer.close(); } });
document.getElementById('copy-password').addEventListener('click', async () => {
  const status = document.getElementById('copy-status');
  try { await navigator.clipboard.writeText('4142'); status.textContent = 'Copied!'; }
  catch (_) { status.textContent = 'Select and copy 4142 above.'; }
});
document.getElementById('year').textContent = new Date().getFullYear();
</script>
</body>
</html>
